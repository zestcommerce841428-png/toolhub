{
  "name": "toolhub",
  "version": "0.1.0",
  "private": true,
  "description": "ToolHub — a 100% client-side catalog of browser-based utilities.",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build:site": "node scripts/build.js",
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./public/assets/css/main.css --minify",
    "build": "npm run clean && npm run build:site && npm run build:css",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./public/assets/css/main.css --watch",
    "serve": "node scripts/serve.js",
    "test": "node --test"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
